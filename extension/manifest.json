{
  "manifest_version": 3,
  "name": "Imbroglio",
  "version": "1.1",
  "description": "The privacy rating for the site you're on, from its own privacy policy and terms.",
  "homepage_url": "https://imbroglio.io",
  "permissions": [
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://imbroglio.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Imbroglio: this site's privacy rating",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
